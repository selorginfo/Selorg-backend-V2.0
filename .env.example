# Selorg Service — environment template
# Copy to `.env` for local development, or `.env.production` for production.
# Never commit real secrets.

# --------------------------------------------------
# Core
# --------------------------------------------------
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
MONGO_URI=
JWT_SECRET=
CUSTOMER_JWT_SECRET=
ALLOWED_ORIGINS=
API_VERSION=1.0.0

# --------------------------------------------------
# Redis (optional — in-memory fallback used when unset)
# --------------------------------------------------
# REDIS_URL=
# REDIS_ENABLED=false
# DISABLE_REDIS=false

# --------------------------------------------------
# Cache
# --------------------------------------------------
# DISABLE_CACHE=false
# CACHE_TTL_DEFAULT=60
# CACHE_TTL_CUSTOMER=60

# --------------------------------------------------
# OTP
# --------------------------------------------------
# OTP_LENGTH=4
# OTP_TTL_SECONDS=300
# OTP_RESEND_COOLDOWN_SECONDS=30
# OTP_DEV_MODE=true
# NOTE: Rider/Picker auth NEVER skips SMS/email providers based on this flag.
# Customer auth also still calls providers (non-prod may soften failure responses).
# Keep unset/false so Twilio/Resend/MSG91 always run for realtime OTP.
# IMPORTANT: do NOT confuse with NODE_ENV=development — delivery runs whenever
# OTP_DEV_MODE is unset/false, even in development (providers must be configured).
# ALLOW_CUSTOMER_TEST_OTP=true
# OTP_TEST_MOBILE=9698790921
# OTP_TEST_OTP=8790
# Max time (ms) the /auth/send-otp response waits for the SMS/email provider before
# returning anyway — delivery then finishes in the background. Keeps the app from
# sitting on a spinner when a gateway is slow. Default 3500.
# OTP_DELIVERY_WAIT_MS=3500
# Per-provider HTTP timeout for the SMS gateways. Default 8000.
# SMS_TIMEOUT_MS=8000

# --------------------------------------------------
# SMS providers (tried in order: generic vendor -> MSG91 -> Fast2SMS -> Twilio)
#
# DELIVERING OTP TO INDIAN (+91) NUMBERS
# --------------------------------------
# India requires TRAI/DLT registration. An unregistered sender is rejected by the
# carrier no matter which provider is used, so one of the following must be true:
#
#  1) MSG91 / Fast2SMS (recommended for +91) - the account must have a registered
#     DLT Entity ID, an approved sender ID (MSG91_SENDER, 6 chars, e.g. SELORG) and
#     an approved template whose ID goes in MSG91_TEMPLATE_ID. SMS_MESSAGE_TEMPLATE
#     must then match the approved DLT template text exactly, with {otp} where the
#     variable is - any difference gets the message rejected.
#
#  2) Twilio - a TRIAL account can only deliver to numbers on the console's verified
#     list; every other destination fails with error 21608 and no SMS is sent. The
#     account must be upgraded AND registered for India A2P before real customers
#     can receive an OTP. A US long code (e.g. +1...) is not a valid India sender.
#
# Leaving all of these unset means no SMS is ever sent - /auth/send-otp will report
# deliveryStatus:"failed" (non-production) or 502 OTP_PROVIDER_ERROR (production).
# --------------------------------------------------
# SMS_VENDOR_URL=
# From project root config.json `smsvendor` (SpearUC / DLT). URL must allow
# appending to_mobileno= & sms_text= (see OTP_PROCESS_WORKFLOW.md).
# Example:
# SMS_VENDOR_URL=http://login4.spearuc.com/MOBILE_APPS_API/sms_api.php?type=smsquicksend&user=USER&pass=PASS&sender=EVOLGN&t_id=TEMPLATE_ID&
# SMS_PARAM_MOBILE=to_mobileno
# SMS_PARAM_MESSAGE=sms_text
# SMS_COUNTRY_CODE=91
# SMS_PREPEND_COUNTRY_CODE=false
# SMS_METHOD=GET
# SMS_MESSAGE_TEMPLATE=Dear Applicant, Your OTP for Mobile No. Verification is {otp} . MJPTBCWREIS - EVOLGN
# OTP_BYPASS_NUMBERS=
# MSG91_AUTH_KEY=
# MSG91_SENDER=
# MSG91_TEMPLATE_ID=
# FAST2SMS_API_KEY=
# FAST2SMS_ROUTE=q
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_WHATSAPP_FROM=

# --------------------------------------------------
# Email (tried in order: Resend -> Brevo -> SendGrid -> SMTP)
# --------------------------------------------------
# EMAIL_HOST=
# EMAIL_PORT=465
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM="Selorg <admin@selorg.com>"
# RESEND_API_KEY=
# BREVO_API_KEY=
# SENDGRID_API_KEY=

# --------------------------------------------------
# Swagger
# --------------------------------------------------
# ENABLE_SWAGGER=true

# --------------------------------------------------
# Picker / rider app
# --------------------------------------------------
# Separate secret for rider JWTs. Falls back to JWT_SECRET when unset; a dedicated
# value is strongly recommended so a leaked rider token cannot be replayed as admin.
# PICKER_JWT_SECRET=
# PICKER_OTP_RESEND_SECONDS=24
# PICKER_OTP_MAX_SENDS=3
# PICKER_OTP_THROTTLE_WINDOW_MINUTES=15
# PICKER_OTP_MAX_VERIFY_ATTEMPTS=5
# PICKER_COD_DEPOSIT_LIMIT=2000
# PICKER_COD_OFFLINE_CARRY_LIMIT=0
# PICKER_SUPPORT_PHONE="+91 1800 266 0800"
# PICKER_SUPPORT_EMAIL=support@selorg.in
# PICKER_MIN_SUPPORTED_VERSION=1.0.0
# PICKER_LATEST_VERSION=1.3.0
# --------------------------------------------------
# Worldline / Paynimo (server-side only — never expose to frontend)
# --------------------------------------------------
# WORLDLINE_ENABLED=1
# WORLDLINE_MERCHANT_ID=
# WORLDLINE_MERCHANT_CODE=
# WORLDLINE_SCHEME_CODE=FIRST
# WORLDLINE_SALT=
# WORLDLINE_HASH_ALGO=sh2
# Saved-instruments strip under Paynimo "All Payment Options". Leave off unless the
# Worldline portal has instrument registration enabled — otherwise the panel stays blank.
# WORLDLINE_ENABLE_EXPRESS_PAY=false
# WORLDLINE_ENC_KEY=
# WORLDLINE_ENC_IV=
# Production callback. Do not point these at localhost on a live server.
# WORLDLINE_RETURN_URL=https://api.selorg.com/api/v1/customer/payments/worldline/return
# WORLDLINE_WEB_APP_URL=https://www.selorg.com
# CUSTOMER_WEB_URL=https://www.selorg.com
# FRONTEND_URL=https://www.selorg.com
# ALLOW_LOCAL_PAYNIMO_REDIRECT=false
# Local gateway test only:
# WORLDLINE_RETURN_URL=http://localhost:3333/api/v1/customer/payments/worldline/return
# WORLDLINE_WEB_APP_URL=http://localhost:3000
# ALLOW_LOCAL_PAYNIMO_REDIRECT=true
# WORLDLINE_MIN_AMOUNT_INR=1
# WORLDLINE_MAX_AMOUNT_INR=100000
# WORLDLINE_RECONCILE_STALE_MINUTES=15
# NOTE: DIDIT_WEBHOOK_BASE_URL must NOT force Worldline "hosted" mode. Local Paynimo
# redirects depend on WORLDLINE_* / API_BASE_URL + ALLOW_LOCAL_PAYNIMO_REDIRECT only.

# PICKER_FEATURE_BULK_DELIVERY=true
# PICKER_FEATURE_EMAIL_LOGIN=true
# PICKER_LOCATION_PING_SECONDS=15
# RIDER_EARNING_BASE_INR=25
# RIDER_EARNING_PER_KM_INR=8
# RIDER_BULK_STOP_PAYOUT_INR=26
# RIDER_BULK_BATCH_BASE_INR=120
# PICKER_PAYOUT_WEEKDAY=1
# PICKER_PAYOUT_SCHEDULE_LABEL="Every Monday · UPI"
# PICKER_MAX_UPLOAD_BYTES=10485760
# PICKER_HUB_TIMEZONE=Asia/Kolkata
