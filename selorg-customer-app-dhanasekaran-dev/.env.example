# APP_MODE: development | production
APP_MODE=development

# selorg-service (customer routes mounted at /api/v1/customer)
DEV_API_BASE_URL=http://localhost:3333/api/v1/customer
PROD_API_BASE_URL=https://api.selorg.com/api/v1/customer

# Backward compatible fallback (used when mode-specific value is missing)
API_BASE_URL=http://localhost:3333/api/v1/customer

# Used for client-side pincode geocoding (ProductDetail delivery check).
# Restrict this key in Google Cloud Console to the Geocoding API only, and to
# your app's package name/SHA-1 (Android) and bundle ID (iOS).
GOOGLE_MAPS_API_KEY=
