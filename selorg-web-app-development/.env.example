# Base URL for the selorg-service backend (customer API, mounted under
# /api/v1/customer/* — see selorg-service/src/app.ts).
#
# Local / SSR (same machine): defaults to http://127.0.0.1:3333 when unset
# (IPv4 loopback — avoids Windows localhost→::1 failures against an IPv4-only backend).
# LAN/mobile testing: leave this unset — the webapp auto-targets the same
# hostname as the page on port 3333 (see resolveApiBaseUrl in src/services/api.ts).
#
# Production (required):
# NEXT_PUBLIC_API_BASE_URL=https://api.selorg.com
#
# Optional backend port when using LAN auto-detection (default 3333):
# NEXT_PUBLIC_API_PORT=3333
#
# Paynimo/Worldline checkout SDK is loaded from paynimo.com at runtime.
# Merchant credentials (WORLDLINE_*) are server-side only — never expose them here.
#
# Maps / geolocation (selorg-service — NOT the webapp):
# GOOGLE_MAPS_API_KEY must be set on selorg-service for:
#   GET /locations/suggestions, /approximate, /reverse, /place-details
# Browser Geolocation requires HTTPS (or localhost). LAN http://192.168.x.x
# often blocks GPS — use localhost or enable HTTPS.
#
# When testing from a phone on your LAN, add your dev origin so Next.js serves
# JS chunks (otherwise buttons on /auth won't work):
NEXT_ALLOWED_DEV_ORIGINS=192.168.1.47
